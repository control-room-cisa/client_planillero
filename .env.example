VITE_API_URL=http://localhost:3000/
VITE_TIMEOUT=10000
# Nombre de empresa mostrado en el login (ej: UPCO, CISA)
VITE_EMPRESA_NOMBRE=UPCO

# Cloudflare Turnstile (site key pública del widget)
# En local usa la clave de prueba (funciona en cualquier host, incl. IP LAN):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# En producción usa la site key real y agrega el hostname en Cloudflare Turnstile.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Consumo de alimentación (deducción en nómina)
VITE_GASTOS_ALIMENTACION_ENDPOINT=http://172.17.10.17:5200/api/employee/reportes/consumo
